{
  "name": "tokyo-night-modern",
  "displayName": "Tokyo Night Modern",
  "description": "A deeper, calmer take on Tokyo Night with a darker UI, softer accents and reworked syntax colors for HTML, CSS/SCSS, JS and TS.",
  "version": "1.0.0",
  "publisher": "yo-l-an",
  "author": {
    "name": "yo-l-an"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yo-l-an/user-styles.git",
    "directory": "vscode"
  },
  "bugs": {
    "url": "https://github.com/yo-l-an/user-styles/issues"
  },
  "homepage": "https://github.com/yo-l-an/user-styles/tree/main/vscode#readme",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "preview": "npm run build && node scripts/preview.js && npm run watch",
    "report": "node scripts/build.js --report",
    "vscode:prepublish": "npm run build"
  },
  "engines": {
