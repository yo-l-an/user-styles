{
  // JSON with comments
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    /* paths are resolved from the project root */
    "baseUrl": ".",
    "paths": {
      "@/*": ["web/scripts/*"]
    }
  },
  "include": ["web"]
}
